# Normalize all text files to LF in the repository.
# Prevents Windows CRLF checkouts from showing every file as modified.
* text=auto eol=lf

# Binary / generated assets - never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary

# Windows-only scripts genuinely need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must stay LF or they break.
*.sh text eol=lf
